{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/.build-${presetName}",
			"cacheVariables": { "FORCE_JSL_CLONE": "OFF" }
		},
		{
			"name": "release",
			"displayName": "Release",
			"inherits": "base",
			"binaryDir": "${sourceDir}/.build",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "ship",
			"displayName": "Ship (Release, JSL cloned from GitHub)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"FORCE_JSL_CLONE": "ON",
				"GDSIMS_MIRROR_FLAGS": "-vf"
			}
		},
		{
			"name": "debug",
			"displayName": "Debug (sanitizers on)",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "profile",
			"displayName": "Profile (RelWithDebInfo)",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
		},
		{
			"name": "test",
			"displayName": "Unit tests (Debug)",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"GDSIMS_BUILD_TESTS": "ON"
			}
		}
	],
	"buildPresets": [
		{ "name": "release", "configurePreset": "release", "configuration": "Release", "targets": ["gdsims"] },
		{ "name": "ship", "configurePreset": "ship", "configuration": "Release", "targets": ["gdsims"] },
		{ "name": "debug", "configurePreset": "debug", "configuration": "Debug", "targets": ["gdsims"] },
		{ "name": "profile", "configurePreset": "profile", "configuration": "RelWithDebInfo", "targets": ["gdsims"] },
		{ "name": "test", "configurePreset": "test", "configuration": "Debug", "targets": ["gdsims_tests"] }
	],
	"testPresets": [
		{
			"name": "test",
			"configurePreset": "test",
			"configuration": "Debug",
			"output": { "outputOnFailure": true }
		}
	]
}
